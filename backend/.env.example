NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/guwahati_homestay?retryWrites=true&w=majority
# Optional: use when a local ISP/router DNS refuses MongoDB SRV lookups.
DNS_SERVERS=

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

FRONTEND_URLS=http://localhost:3000,https://example.com

# Store uploaded site logos and favicons outside the Git checkout in production.
# Uploaded public media. Use a persistent path outside the repository in production.
UPLOAD_DIR=./uploads

# When all three credentials are configured, new images and videos are stored in Cloudinary.
# Never expose CLOUDINARY_API_SECRET in frontend environment variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stayhaven
